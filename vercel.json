{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/page.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://dev-backend-rho.vercel.app/api/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://dev-backend-rho.vercel.app/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://dev-backend-rho.vercel.app/health"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/page"
    },
    {
      "source": "/hackathons",
      "destination": "/api/page"
    },
    {
      "source": "/explore",
      "destination": "/api/page"
    },
    {
      "source": "/login",
      "destination": "/api/page"
    },
    {
      "source": "/signup",
      "destination": "/api/page"
    },
    {
      "source": "/h/:id",
      "destination": "/api/page"
    },
    {
      "source": "/u/:user",
      "destination": "/api/page"
    },
    {
      "source": "/((?!api/|assets/|favicon|og-image|robots|manifest|site\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
